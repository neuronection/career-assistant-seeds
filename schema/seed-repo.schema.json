{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronection.com/contracts/seed-repo.schema.json",
  "title": "Career seed repository index",
  "description": "Root index for a Career Assistant seed repository. Data-only; no code is executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "publisher", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "career-seed-repo" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "homepage": { "type": "string", "format": "uri" },
        "contact": { "type": "string", "maxLength": 200 }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "manifest", "itemTypes", "license", "version", "digest", "signature"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "path": { "type": "string", "pattern": "^packs/[a-z][a-z0-9-]{1,63}/[a-z][a-z0-9-]{1,63}$" },
          "manifest": { "type": "string", "pattern": "^packs/[a-z][a-z0-9-]{1,63}/[a-z][a-z0-9-]{1,63}/manifest\\.json$" },
          "itemTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }
          },
          "license": {
            "type": "string",
            "enum": ["Apache-2.0", "CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "MIT"]
          },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "signature": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["alg", "keyId", "value"],
                "properties": {
                  "alg": { "const": "ed25519" },
                  "keyId": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "value": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
