{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronection.com/contracts/item-envelope.schema.json",
  "title": "Career seed item envelope",
  "description": "One item file: a typed envelope plus a format-specific items array. The envelope is format-agnostic; item schemas live in docs/formats/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "items"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type", "format", "format_version", "dataset_vintage"],
      "properties": {
        "item_type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "format": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
        "format_version": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "dataset_vintage": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "license": { "type": "string", "minLength": 1, "maxLength": 120 },
        "attribution": { "type": "string", "maxLength": 500 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "format": "uri" },
            "commit": { "type": "string", "maxLength": 120 },
            "retrieved_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      },
      "patternProperties": {
        "^x-": {}
      }
    },
    "items": { "type": "array", "maxItems": 10000 }
  }
}
